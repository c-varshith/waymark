# Leave DATABASE_URL unset for local SQLite development.
# For production, use the Supabase session pooler URL when Render requires IPv4.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=waymark-files
WAYMARK_DB=waymark.db
WAYMARK_DATA_DIR=data
WAYMARK_JWT_SECRET=replace-with-a-long-random-secret

# Live traffic (display only; never changes risk scores). A TomTom key enables both the congestion
# lines on watched hotspot roads and the street-network flow tiles. The key stays on the server.
# WAYMARK_TRAFFIC_API_KEY=
# WAYMARK_TRAFFIC_TILE_DAILY_CAP=40000
# Experimental scoring from a separately licensed historical traffic archive; off by default.
WAYMARK_TRAFFIC_LIFT=false
